    "updatedAt": "2026-10-02T00:00:00.000Z"
  },
  {
    "id": "s-76df16df8890",
    "parentId": "s-8bf12cd08747",
    "title": "学分机制",
    "body": "",
    "position": 49,
    "revision": 1,
